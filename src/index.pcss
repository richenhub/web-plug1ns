:root {
    padding: 0;
    margin: 0;
    height: auto;
}

body {
    background-color: #f5f6fa;
    background-color: #f5f6fa;
    height: auto;
}

a {
    text-decoration: inherit;
    color: inherit;

    &:hover {
        cursor: pointer;
    }
}

button {
    &:hover {
        cursor: pointer;
    }
}

h2 {
    margin: 0;
}

@font-face {
    font-family: 'MinecraftMain';
    src: url('/assets/fonts/minecraft-main.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
}